{
  "entities": {
    "SiteSettings": {
      "title": "SiteSettings",
      "description": "Public website settings, brand identity, TOMOYO philosophy, contact info, and homepage section config.",
      "type": "object",
      "properties": {
        "institutionName": { "type": "string", "maxLength": 120 },
        "tagline": { "type": "string", "maxLength": 160 },
        "foundedDate": { "type": "string", "maxLength": 80 },
        "logoUrl": { "type": "string", "maxLength": 500 },
        "faviconUrl": { "type": "string", "maxLength": 500 },
        "headerImageUrl": { "type": "string", "maxLength": 500 },
        "canonicalDomain": { "type": "string", "maxLength": 200 },
        "shortDescription": { "type": "string", "maxLength": 600 },
        "aboutTitle": { "type": "string", "maxLength": 160 },
        "aboutContent": { "type": "string", "maxLength": 5000 },
        "vision": { "type": "string", "maxLength": 1500 },
        "mission": { "type": "array", "maxLength": 20 },
        "brandMeaning": { "type": "string", "maxLength": 500 },
        "philosophy": { "type": "array", "maxLength": 10 },
        "advantages": { "type": "array", "maxLength": 12 },
        "whatsappNumber": { "type": "string", "maxLength": 40 },
        "whatsappUrl": { "type": "string", "maxLength": 200 },
        "email": { "type": "string", "maxLength": 160 },
        "instagramUrl": { "type": "string", "maxLength": 300 },
        "facebookUrl": { "type": "string", "maxLength": 300 },
        "youtubeUrl": { "type": "string", "maxLength": 300 },
        "heroHeadline": { "type": "string", "maxLength": 200 },
        "heroSubheadline": { "type": "string", "maxLength": 500 },
        "homeSections": { "type": "array", "maxLength": 20 },
        "statsOverride": { "type": "object" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["institutionName", "canonicalDomain", "whatsappNumber"]
    },
    "SeoSetting": {
      "title": "SeoSetting",
      "description": "Page-level and default SEO metadata configuration.",
      "type": "object",
      "properties": {
        "pageKey": { "type": "string", "maxLength": 80, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "maxLength": 160 },
        "description": { "type": "string", "maxLength": 320 },
        "ogImageUrl": { "type": "string", "maxLength": 500 },
        "noIndex": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["pageKey", "title", "description"]
    },
    "SitePage": {
      "title": "SitePage",
      "description": "Editable CMS content blocks for public pages.",
      "type": "object",
      "properties": {
        "slug": { "type": "string", "maxLength": 100, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "maxLength": 200 },
        "subtitle": { "type": "string", "maxLength": 400 },
        "body": { "type": "string", "maxLength": 15000 },
        "status": { "type": "string", "enum": ["draft", "published"] },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["slug", "title", "status"]
    },
    "FounderProfile": {
      "title": "FounderProfile",
      "description": "Founder profile details managed by admin.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 160 },
        "birthDate": { "type": "string", "maxLength": 60 },
        "role": { "type": "string", "maxLength": 120 },
        "photoUrl": { "type": "string", "maxLength": 500 },
        "bio": { "type": "string", "maxLength": 8000 },
        "education": { "type": "array", "maxLength": 20 },
        "experience": { "type": "array", "maxLength": 20 },
        "vision": { "type": "string", "maxLength": 2000 },
        "message": { "type": "string", "maxLength": 2000 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "birthDate", "role"]
    },
    "Teacher": {
      "title": "Teacher",
      "description": "Teacher profile with dynamic slug, SEO metadata, and publication status.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 160 },
        "slug": { "type": "string", "maxLength": 120, "pattern": "^[a-z0-9_\\-]+$" },
        "previousSlugs": { "type": "array", "maxLength": 20 },
        "photoUrl": { "type": "string", "maxLength": 500 },
        "bio": { "type": "string", "maxLength": 5000 },
        "education": { "type": "string", "maxLength": 1000 },
        "experience": { "type": "string", "maxLength": 2000 },
        "subjects": { "type": "array", "maxLength": 20 },
        "isActive": { "type": "boolean" },
        "status": { "type": "string", "enum": ["draft", "published"] },
        "order": { "type": "number" },
        "seoTitle": { "type": "string", "maxLength": 160 },
        "seoDescription": { "type": "string", "maxLength": 320 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "slug", "isActive", "status", "order"]
    },
    "Branch": {
      "title": "Branch",
      "description": "TOMOYO learning center branch information.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 160 },
        "slug": { "type": "string", "maxLength": 100, "pattern": "^[a-z0-9_\\-]+$" },
        "isCenter": { "type": "boolean" },
        "photoUrl": { "type": "string", "maxLength": 500 },
        "description": { "type": "string", "maxLength": 3000 },
        "address": { "type": "string", "maxLength": 500 },
        "whatsapp": { "type": "string", "maxLength": 40 },
        "operatingHours": { "type": "string", "maxLength": 300 },
        "mapsUrl": { "type": "string", "maxLength": 500 },
        "isActive": { "type": "boolean" },
        "order": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "slug", "mapsUrl", "isActive", "order"]
    },
    "Program": {
      "title": "Program",
      "description": "Dynamic learning program with grade range and subject selection rules.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 160 },
        "slug": { "type": "string", "maxLength": 100, "pattern": "^[a-z0-9_\\-]+$" },
        "levelLabel": { "type": "string", "maxLength": 120 },
        "description": { "type": "string", "maxLength": 3000 },
        "selectionMode": { "type": "string", "enum": ["single", "multiple"] },
        "status": { "type": "string", "enum": ["draft", "published"] },
        "isActive": { "type": "boolean" },
        "order": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "slug", "levelLabel", "selectionMode", "status", "isActive", "order"]
    },
    "Subject": {
      "title": "Subject",
      "description": "Subject linked to a learning program.",
      "type": "object",
      "properties": {
        "programId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "maxLength": 140 },
        "levelLabel": { "type": "string", "maxLength": 120 },
        "description": { "type": "string", "maxLength": 1000 },
        "isActive": { "type": "boolean" },
        "order": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["programId", "name", "isActive", "order"]
    },
    "GalleryItem": {
      "title": "GalleryItem",
      "description": "Activity photo item in gallery.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 160 },
        "description": { "type": "string", "maxLength": 1000 },
        "imageUrl": { "type": "string", "maxLength": 500 },
        "activityDate": { "type": "string", "maxLength": 40 },
        "category": { "type": "string", "maxLength": 80 },
        "order": { "type": "number" },
        "status": { "type": "string", "enum": ["draft", "published"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "imageUrl", "status", "order"]
    },
    "Testimonial": {
      "title": "Testimonial",
      "description": "Verified testimonial managed by admin.",
      "type": "object",
      "properties": {
        "authorName": { "type": "string", "maxLength": 120 },
        "authorRole": { "type": "string", "maxLength": 120 },
        "photoUrl": { "type": "string", "maxLength": 500 },
        "content": { "type": "string", "maxLength": 1500 },
        "isVisible": { "type": "boolean" },
        "order": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["authorName", "content", "isVisible", "order"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Published announcement with slug and SEO metadata.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "slug": { "type": "string", "maxLength": 140, "pattern": "^[a-z0-9_\\-]+$" },
        "previousSlugs": { "type": "array", "maxLength": 20 },
        "excerpt": { "type": "string", "maxLength": 400 },
        "content": { "type": "string", "maxLength": 15000 },
        "imageUrl": { "type": "string", "maxLength": 500 },
        "publishedAt": { "type": "string", "maxLength": 40 },
        "status": { "type": "string", "enum": ["draft", "published"] },
        "seoTitle": { "type": "string", "maxLength": 160 },
        "seoDescription": { "type": "string", "maxLength": 320 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "slug", "content", "status"]
    },
    "Schedule": {
      "title": "Schedule",
      "description": "Class schedule item.",
      "type": "object",
      "properties": {
        "programId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "programName": { "type": "string", "maxLength": 160 },
        "className": { "type": "string", "maxLength": 120 },
        "subjectName": { "type": "string", "maxLength": 140 },
        "teacherId": { "type": "string", "maxLength": 128 },
        "teacherName": { "type": "string", "maxLength": 160 },
        "dayOfWeek": { "type": "string", "maxLength": 40 },
        "startTime": { "type": "string", "maxLength": 20 },
        "endTime": { "type": "string", "maxLength": 20 },
        "branchId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "branchName": { "type": "string", "maxLength": 160 },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["programId", "className", "dayOfWeek", "startTime", "endTime", "branchId", "isActive"]
    },
    "Parent": {
      "title": "Parent",
      "description": "Parent/guardian PII profile strictly isolated to owner and admin.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "maxLength": 160 },
        "email": { "type": "string", "maxLength": 200 },
        "whatsapp": { "type": "string", "maxLength": 40 },
        "address": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "name", "email", "whatsapp", "address"]
    },
    "Student": {
      "title": "Student",
      "description": "Student record owned by parentUid and managed by admin.",
      "type": "object",
      "properties": {
        "parentUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "parentName": { "type": "string", "maxLength": 160 },
        "fullName": { "type": "string", "maxLength": 160 },
        "photoUrl": { "type": "string", "maxLength": 500 },
        "photoConsent": { "type": "boolean" },
        "birthDate": { "type": "string", "maxLength": 20 },
        "gender": { "type": "string", "enum": ["Laki-laki", "Perempuan"] },
        "gradeLevel": { "type": "string", "maxLength": 80 },
        "programId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "programNameSnapshot": { "type": "string", "maxLength": 160 },
        "subjectIds": { "type": "array", "maxLength": 20 },
        "subjectNamesSnapshot": { "type": "array", "maxLength": 20 },
        "branchId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "branchNameSnapshot": { "type": "string", "maxLength": 160 },
        "address": { "type": "string", "maxLength": 500 },
        "notes": { "type": "string", "maxLength": 1000 },
        "registrationStatus": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "isActive": { "type": "boolean" },
        "monthlyFee": { "type": "number" },
        "billingAnchorDay": { "type": "number" },
        "startDate": { "type": "string", "maxLength": 20 },
        "adminNotes": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "parentUid", "fullName", "birthDate", "gender", "gradeLevel",
        "programId", "programNameSnapshot", "subjectIds", "subjectNamesSnapshot",
        "branchId", "branchNameSnapshot", "address", "registrationStatus", "isActive", "monthlyFee"
      ]
    },
    "Registration": {
      "title": "Registration",
      "description": "Enrollment submission with immutable curriculum snapshots.",
      "type": "object",
      "properties": {
        "parentUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "studentId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "parentNameSnapshot": { "type": "string", "maxLength": 160 },
        "parentEmailSnapshot": { "type": "string", "maxLength": 200 },
        "parentWhatsappSnapshot": { "type": "string", "maxLength": 40 },
        "studentNameSnapshot": { "type": "string", "maxLength": 160 },
        "gradeLevel": { "type": "string", "maxLength": 80 },
        "programId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "programNameSnapshot": { "type": "string", "maxLength": 160 },
        "subjectNamesSnapshot": { "type": "array", "maxLength": 20 },
        "branchId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "branchNameSnapshot": { "type": "string", "maxLength": 160 },
        "notes": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "adminNotes": { "type": "string", "maxLength": 1000 },
        "reviewedAt": { "type": "string", "maxLength": 40 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "parentUid", "studentId", "parentNameSnapshot", "studentNameSnapshot",
        "gradeLevel", "programId", "programNameSnapshot", "subjectNamesSnapshot",
        "branchId", "branchNameSnapshot", "status"
      ]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "Monthly SPP invoice with anchor day and due date.",
      "type": "object",
      "properties": {
        "studentId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "parentUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "studentNameSnapshot": { "type": "string", "maxLength": 160 },
        "parentNameSnapshot": { "type": "string", "maxLength": 160 },
        "programNameSnapshot": { "type": "string", "maxLength": 160 },
        "branchId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "branchNameSnapshot": { "type": "string", "maxLength": 160 },
        "periodYear": { "type": "number" },
        "periodMonth": { "type": "number" },
        "periodLabel": { "type": "string", "maxLength": 60 },
        "amount": { "type": "number" },
        "anchorDay": { "type": "number" },
        "dueDate": { "type": "string", "maxLength": 20 },
        "status": { "type": "string", "enum": ["unpaid", "paid"] },
        "paidAt": { "type": "string", "maxLength": 40 },
        "paymentMethod": { "type": "string", "enum": ["Tunai", "Transfer", ""] },
        "paymentId": { "type": "string", "maxLength": 128 },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "studentId", "parentUid", "studentNameSnapshot", "parentNameSnapshot",
        "programNameSnapshot", "branchId", "branchNameSnapshot",
        "periodYear", "periodMonth", "periodLabel", "amount", "anchorDay", "dueDate", "status"
      ]
    },
    "Payment": {
      "title": "Payment",
      "description": "Immutable SPP payment receipt snapshot recorded by admin.",
      "type": "object",
      "properties": {
        "invoiceId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "studentId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "parentUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "receiptNumber": { "type": "string", "maxLength": 80 },
        "studentNameSnapshot": { "type": "string", "maxLength": 160 },
        "parentNameSnapshot": { "type": "string", "maxLength": 160 },
        "programNameSnapshot": { "type": "string", "maxLength": 160 },
        "branchId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "branchNameSnapshot": { "type": "string", "maxLength": 160 },
        "periodLabel": { "type": "string", "maxLength": 60 },
        "amountSnapshot": { "type": "number" },
        "paymentDate": { "type": "string", "maxLength": 20 },
        "paymentMethod": { "type": "string", "enum": ["Tunai", "Transfer"] },
        "notes": { "type": "string", "maxLength": 500 },
        "recordedByUid": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "invoiceId", "studentId", "parentUid", "receiptNumber",
        "studentNameSnapshot", "parentNameSnapshot", "programNameSnapshot",
        "branchId", "branchNameSnapshot", "periodLabel", "amountSnapshot",
        "paymentDate", "paymentMethod", "recordedByUid"
      ]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "Contact inquiry sent by public visitors.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 160 },
        "whatsapp": { "type": "string", "maxLength": 40 },
        "email": { "type": "string", "maxLength": 200 },
        "branchName": { "type": "string", "maxLength": 160 },
        "message": { "type": "string", "maxLength": 2000 },
        "status": { "type": "string", "enum": ["new", "read", "replied"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "whatsapp", "message", "status"]
    }
  },
  "firestore": {
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/SiteSettings" },
      "description": "Global site settings and brand identity configuration."
    },
    "/seoSettings/{seoId}": {
      "schema": { "$ref": "#/entities/SeoSetting" },
      "description": "SEO metadata overrides per route."
    },
    "/sitePages/{pageId}": {
      "schema": { "$ref": "#/entities/SitePage" },
      "description": "CMS editable page content."
    },
    "/founder/{founderId}": {
      "schema": { "$ref": "#/entities/FounderProfile" },
      "description": "Founder profile document."
    },
    "/teachers/{teacherId}": {
      "schema": { "$ref": "#/entities/Teacher" },
      "description": "Teacher profiles with publication status and dynamic slug."
    },
    "/branches/{branchId}": {
      "schema": { "$ref": "#/entities/Branch" },
      "description": "Branch offices (Indramayu Kota & Terisi)."
    },
    "/programs/{programId}": {
      "schema": { "$ref": "#/entities/Program" },
      "description": "Dynamic learning programs."
    },
    "/subjects/{subjectId}": {
      "schema": { "$ref": "#/entities/Subject" },
      "description": "Subjects associated with learning programs."
    },
    "/galleries/{galleryId}": {
      "schema": { "$ref": "#/entities/GalleryItem" },
      "description": "Activity gallery photos."
    },
    "/testimonials/{testimonialId}": {
      "schema": { "$ref": "#/entities/Testimonial" },
      "description": "Parent and student testimonials."
    },
    "/announcements/{announcementId}": {
      "schema": { "$ref": "#/entities/Announcement" },
      "description": "Announcements and news posts."
    },
    "/schedules/{scheduleId}": {
      "schema": { "$ref": "#/entities/Schedule" },
      "description": "Public learning schedules."
    },
    "/parents/{parentId}": {
      "schema": { "$ref": "#/entities/Parent" },
      "description": "Parent PII records keyed by Firebase Auth UID."
    },
    "/students/{studentId}": {
      "schema": { "$ref": "#/entities/Student" },
      "description": "Student records linked to parentUid."
    },
    "/registrations/{registrationId}": {
      "schema": { "$ref": "#/entities/Registration" },
      "description": "Student enrollment submissions."
    },
    "/invoices/{invoiceId}": {
      "schema": { "$ref": "#/entities/Invoice" },
      "description": "Monthly SPP billing invoices."
    },
    "/payments/{paymentId}": {
      "schema": { "$ref": "#/entities/Payment" },
      "description": "Recorded SPP payment receipts."
    },
    "/contactMessages/{messageId}": {
      "schema": { "$ref": "#/entities/ContactMessage" },
      "description": "Public contact form inquiries."
    }
  }
}
